{
  "name": "dsh-mobile-ui",
  "version": "1.0.0",
  "description": "手机浏览器适配：给 DSH Web 界面注入移动端样式与视口处理（不改源码，走 webserver/index-inject 注入口）。",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mobile",
    "responsive",
    "手机适配"
  ],
  "license": "MIT",
  "private": true
}
